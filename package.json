{
  "name": "dsh-sidebar-media-player",
  "version": "0.2.4",
  "description": "Unified audio + video player for dsh-better-sidebar: one file viewer for mp4/webm/mov/m4v/ogv and mp3/wav/flac/ogg/opus/m4a/aac, with a draggable whole-track scrubber, live spectrum bars and pitch (Hz + note name), streamed from a Range(206) host route so seeking really works. Note: the current 0.2.x build still has a number of known bugs and is being reworked.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "screenshots.json",
    "icon.svg",
    "locale/*.json",
    "docs/screenshots/**",
    "!lib/*.bak*",
    "!lib/**/*.bak*",
    "!lib/*.BROKEN*"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "better-sidebar",
    "media",
    "audio",
    "video",
    "player",
    "spectrum",
    "pitch",
    "file-viewer",
    "range-request"
  ],
  "license": "MIT",
  "author": "loyalchiiina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-sidebar-media-player.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
